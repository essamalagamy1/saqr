{
  "name": "saqr-edge-agent",
  "version": "1.0.0",
  "description": "Saqr Edge Agent — AI-powered camera monitoring for Windows",
  "main": "src/main.js",
  "author": "Saqr",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "onnxruntime-node": "^1.21.0",
    "sharp": "^0.33.5",
    "node-fetch": "^2.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.saqr.edge-agent",
    "productName": "Saqr Edge Agent",
    "copyright": "Copyright © 2026 Saqr",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "compression": "maximum",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "models/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/ia32/**",
      "!node_modules/@ffmpeg-installer/linux*/**",
      "!node_modules/@ffmpeg-installer/darwin*/**",
      "!node_modules/@img/sharp-linux*/**",
      "!node_modules/@img/sharp-darwin*/**",
      "!node_modules/@img/sharp-libvips-linux*/**",
      "!node_modules/@img/sharp-libvips-darwin*/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models/",
        "to": "models/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    }
  }
}
