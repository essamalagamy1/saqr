# ===========================================
# Rased — Environment Variables
# ===========================================
# Copy this file to .env and update values
# cp .env.example .env

# Database
DATABASE_URL=postgres://rased:rased@localhost:5432/rased?sslmode=disable

# Redis (Port 6380 in docker-compose to avoid conflict with host redis on 6379)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=rased-dev-secret-change-in-production
JWT_EXPIRY=24h

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rased
S3_SECRET_KEY=rased123456
S3_BUCKET=rased-media
S3_REGION=us-east-1

# MQTT
MQTT_BROKER=tcp://localhost:1883
MQTT_CLIENT_ID=rased-api
MQTT_USERNAME=
MQTT_PASSWORD=

# MediaMTX
MEDIAMTX_API=http://localhost:9997

# App
APP_PORT=8080
APP_ENV=development
APP_URL=http://localhost:3000
